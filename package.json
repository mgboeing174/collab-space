{
  "name": "collabspace",
  "version": "1.0.0",
  "type": "module",
  "description": "CollabSpace — A Real-Time Collaborative Workspace",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "build": "npm --prefix client run build"
  },
  "keywords": [
    "collaboration",
    "realtime",
    "documents",
    "whiteboard",
    "socketio",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
